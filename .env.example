# Immutable public artifact release verified against the remote manifest.
S4_MODELSCOPE_REVISION=3686874898fdf908431db487468f21a527507988
S4_MODELSCOPE_REPO=zfy2qiling/qiling_smolvla
S4_MODELSCOPE_UPLOAD_WORKERS=4
# Uploads always target the writable release branch; consumers use the pinned
# immutable revision above.
S4_MODELSCOPE_UPLOAD_REVISION=master

# `./s4` fills these automatically. Set them only when invoking Compose
# directly from an environment that does not export the current user IDs.
S4_HOST_UID=1000
S4_HOST_GID=1000

S4_SIM_IMAGE=s4-smolvla-sim:dev
S4_POLICY_IMAGE=s4-smolvla-policy:dev
S4_ROBOT_IMAGE=s4-smolvla-robot:dev
S4_ARTIFACT_IMAGE=s4-smolvla-artifacts:dev
S4_ROS_BASE_IMAGE=ros:humble-ros-base-jammy@sha256:1813d3c85d7f96ff7d3012d865204583255740182db5d0065f8f8cd029a83138

# Build inputs are independent of the host NVIDIA driver. Keep the CUDA image
# digest pinned; the host only supplies a sufficiently new kernel driver via
# NVIDIA Container Toolkit at runtime.
S4_CUDA_BASE_IMAGE=nvidia/cuda:12.8.1-base-ubuntu22.04@sha256:001469ea0f3dec85a1ca929aeea3b58ae369d4c11228b10aec1f642bb6ca7a6f
S4_ARTIFACT_BASE_IMAGE=python:3.12-slim-bookworm

# Image-build network settings. `host` lets a native Linux Docker build reach
# a proxy listening on the host. Override the index when pypi.org is slow.
S4_BUILD_NETWORK=host
S4_PIP_INDEX_URL=https://pypi.org/simple
S4_PIP_DEFAULT_TIMEOUT=300
S4_PIP_RETRIES=10

# Optional local proxy for Dockerfile RUN steps. On native Linux the Compose
# builds use host networking, so 127.0.0.1 addresses the Docker host.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=127.0.0.1,localhost,mirrors.aliyun.com,modelscope.cn,.modelscope.cn,aliyuncs.com,.aliyuncs.com
# S4_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple

# Directory containing the versioned `5.1/Isaac/...` subset.
S4_ISAAC_ASSETS_DIR=./s4_smolvla_isaaclab/local_assets/isaac
S4_ISAAC_DOWNLOAD_WORKERS=6
# Only needed while generating the subset. Point this at the extracted
# NVIDIA Local Assets Pack directory whose direct child is `Isaac/`.
# S4_ISAAC_ASSET_SOURCE_DIR=/path/to/Assets/Isaac/5.1

# Real robot deployment. `lo` is correct only when the ROS publishers are on
# this same host; set the commissioned robot NIC and DDS domain otherwise.
S4_POLICY_SERVER_HOST=127.0.0.1
ROS_DOMAIN_ID=16
HW_TELEOP_NETWORK_INTERFACE=lo
# Physical RealSense serials are machine-local. Obtain them with
# `./s4 camera list` during on-robot commissioning; never commit them.
S4_CAMERA_HEAD_SERIAL=S4_HEAD_SERIAL_NOT_CONFIGURED
S4_CAMERA_WRIST_LEFT_SERIAL=S4_WRIST_LEFT_SERIAL_NOT_CONFIGURED
S4_CAMERA_WRIST_RIGHT_SERIAL=S4_WRIST_RIGHT_SERIAL_NOT_CONFIGURED
