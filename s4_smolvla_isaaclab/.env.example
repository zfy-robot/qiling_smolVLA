# Copy to .env and adjust paths for this workstation.
S4_PROJECT_ROOT=/path/to/s4_smolvla_isaaclab
ISAACLAB_ROOT=/path/to/IsaacLab
ISAAC_ASSET_ROOT=/path/to/isaacsim_assets/Assets/Isaac/5.1
# Runtime default is <project>/local_assets/isaac/5.1. Set this only when
# keeping the separately distributed scene bundle somewhere else.
S4_SCENE_ASSET_ROOT=/path/to/s4_smolvla_isaaclab/local_assets/isaac/5.1
LEROBOT_ROOT=/path/to/lerobot
SMOLVLA_MODEL_ROOT=/path/to/s4_smolvla_isaaclab/models
S4_DATA_ROOT=/path/to/s4_smolvla_isaaclab/datasets
S4_OUTPUT_ROOT=/path/to/s4_smolvla_isaaclab/outputs
S4_CACHE_ROOT=/path/to/s4_smolvla_isaaclab/.cache
S4_ISAACLAB_ENV=env_isaaclab
S4_SMOLVLA_ENV=smolvla
# Optional: override configs/active_task.default without changing Git files.
# S4_TASK=drawer_insert_close
