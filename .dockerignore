# Release images contain environments and source dependencies only. Runtime
# assets, datasets, checkpoints and outputs are downloaded or generated on the
# host and bind-mounted by Compose; never send them in a Docker build context.
.git
**/.git
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.cache
**/.DS_Store
**/*.swp
**/*~
.s4/
release/staging/
docker/runtime/
docker/vendor/kit-exts/
s4_smolvla_isaaclab/assets/
s4_smolvla_isaaclab/local_assets/
s4_smolvla_isaaclab/models/
s4_smolvla_isaaclab/datasets/
s4_smolvla_isaaclab/outputs/

# Workstation-only path overrides must never replace container paths.
.env
**/.env

# Generated ROS build trees contain absolute host symlinks and are not needed
# by the simulation/data/training/rollout pipeline.  ROS source remains copied.
s4_smolvla_isaaclab/hardware_teleop/ros_ws/build/
s4_smolvla_isaaclab/hardware_teleop/ros_ws/install/
s4_smolvla_isaaclab/hardware_teleop/ros_ws/log/
